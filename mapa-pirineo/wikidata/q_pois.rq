PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
SELECT ?item ?lon ?lat (SAMPLE(?t) AS ?type) (MAX(?sl) AS ?sitelinks) (SAMPLE(?es) AS ?les) (SAMPLE(?ca) AS ?lca) (SAMPLE(?fr) AS ?lfr) (SAMPLE(?eu) AS ?leu) WHERE {
  VALUES ?t { wd:Q23413 wd:Q44613 wd:Q160742 wd:Q2977 wd:Q57821 wd:Q839954 wd:Q1088552 wd:Q2088357 wd:Q16560 wd:Q817056 wd:Q12518 wd:Q1785071 }
  ?item wdt:P31 ?t .
  ?item wdt:P625 ?coord .
  BIND(geof:longitude(?coord) AS ?lon) BIND(geof:latitude(?coord) AS ?lat)
  FILTER(?lon > -2.15 && ?lon < 3.50 && ?lat > 41.94 && ?lat < 43.62)
  ?item wikibase:sitelinks ?sl .
  OPTIONAL { ?item rdfs:label ?es FILTER(LANG(?es)="es") }
  OPTIONAL { ?item rdfs:label ?ca FILTER(LANG(?ca)="ca") }
  OPTIONAL { ?item rdfs:label ?fr FILTER(LANG(?fr)="fr") }
  OPTIONAL { ?item rdfs:label ?eu FILTER(LANG(?eu)="eu") }
}
GROUP BY ?item ?lon ?lat
